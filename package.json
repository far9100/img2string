{
  "name": "img2string",
  "version": "0.1.0",
  "description": "Turn a picture into string art: one continuous thread per colour around pins on a round or rectangular frame, with a nail template, winding instructions and a step-by-step player.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4337 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "e2e": "playwright test --project=msedge --project=mobile",
    "e2e:ci": "playwright test --project=chromium --project=mobile",
    "bench": "node scripts/bench.ts",
    "bench:browser": "playwright test --project=bench",
    "font:subset": "python scripts/subset_font.py"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
